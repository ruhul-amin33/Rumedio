# ---- freedb.tech MySQL (dashboard theke copy korun) ----
DB_HOST=sql.freedb.tech
DB_PORT=3306
DB_USER=freedb_yourusername
DB_PASSWORD=your_password
DB_NAME=freedb_yourdbname

# Sudhu jodi provider SSL chay (freedb.tech e lagbe na)
# DB_SSL=true

# ---- Security ----
# Ekta lomba random string din (kom pokkhe 32 character)
JWT_SECRET=change-me-to-a-long-random-string
# Ei email diye register korle automatic Admin hobe
ADMIN_EMAIL=you@example.com
